# Ignore every runtime file under these folders except their root README.md.
# Approved snapshots remain reviewable in version control.
/.autoresearch/experimentation/**
!/.autoresearch/experimentation/README.md
/.autoresearch/rejected/**
!/.autoresearch/rejected/README.md

# Common local runtime/build artifacts for Python and .NET targets.
__pycache__/
*.py[co]
.venv/
venv/
bin/
obj/
build/
dist/
*.egg-info/
